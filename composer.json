{
    "name": "sunrice/starters",
    "description": "Development repository for the Sunrice starter sites: one Composer package each, installed with sunrice/starter-kit.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "sunrice/starter-real-estate": "@dev"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1",
        "spatie/laravel-responsecache": "^8.4"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "sunrice/packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "sunrice/admin": "dev-main",
                    "sunrice/cms": "dev-main",
                    "sunrice/starter-kit": "dev-main"
                }
            }
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "Sunrice\\Starters\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
